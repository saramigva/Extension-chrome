{
  "manifest_version": 3,
  "name": "Radar de webs: detecta webs anticuadas y sus contactos",
  "short_name": "Radar de webs",
  "description": "Al abrir una web te dice si está anticuada, sus puntos de dolor y contactos, y te prepara el mensaje y una demo antes/después. Todo local.",
  "version": "0.2.0",
  "minimum_chrome_version": "120",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" } },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options.html",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["*://*.google.com/search*", "*://*.google.es/search*", "*://*.google.pt/search*"],
      "js": ["page.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.google.com/search*", "https://www.google.es/search*", "https://www.google.pt/search*"],
      "js": ["serp.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
